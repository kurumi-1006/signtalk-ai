DEVICE_ID=uno-q-demo
DEVICE_KEY_ID=demo-key
DEVICE_SECRET=replace-with-device-secret
API_URL=http://192.168.1.10:3000/api/v1
OUTBOX_DB_PATH=./data/outbox.db
LOG_LEVEL=INFO
MOCK_MODE=true
MODEL_PATH=./models/vsl_metric_lowshot/best_vsl_metric_encoder.pt
LABELS_PATH=./models/vsl_metric_lowshot/labels.csv
ACTIVE_MODEL_ID=vsl_metric_lowshot
# VSL-30 accepts the same video/JPEG endpoint and internally creates the
# required [1, 48, 75, 4] MediaPipe pose-and-hands keypoint tensor.
# ACTIVE_MODEL_ID=vsl30_keypoint_classifier
EDGE_HOST=0.0.0.0
EDGE_PORT=8082
CORS_ORIGINS=*
# Calibrate these against held-out recordings before production rollout.
MIN_WORD_CONFIDENCE=0.62
MIN_WORD_MARGIN=0.10
MIN_LANDMARK_COVERAGE=0.5
