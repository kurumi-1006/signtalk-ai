FROM python:3.11-slim-bookworm

WORKDIR /app
COPY services/edge-ai ./services/edge-ai
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir ./services/edge-ai

# Keep this after the Python install so an App Lab rebuild can reuse its large
# cached pip layer and download only these small system libraries.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/services/edge-ai
CMD ["python", "-m", "src.main", "--serve", "--port", "8082"]
