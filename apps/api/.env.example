NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://signbridge:signbridge@localhost:5432/signbridge
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-minimum-32-character-development-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SWAGGER_ENABLED=true
LOG_LEVEL=debug
DEVICE_SEED_SECRET=replace-with-device-secret
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
