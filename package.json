{
  "name": "signtalk-ai",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @signtalk-ai/mobile dev",
    "dev:web": "pnpm --filter @signtalk-ai/mobile exec expo start --web",
    "build": "pnpm --filter @signtalk-ai/mobile typecheck",
    "lint": "pnpm --filter @signtalk-ai/mobile lint",
    "typecheck": "pnpm --filter @signtalk-ai/mobile typecheck",
    "test": "pnpm --filter @signtalk-ai/mobile test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.0.0"
  }
}
