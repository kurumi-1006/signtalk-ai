{
  "name": "signtalk-ai",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @signtalk/api dev",
    "dev:api": "pnpm --filter @signtalk/api dev",
    "dev:web": "pnpm --filter @signtalk/mobile exec expo start --web",
    "dev:infra": "docker compose -f infrastructure/compose.dev.yml up",
    "build": "pnpm --filter @signtalk/contracts build && pnpm --filter @signtalk/api build && pnpm --filter @signtalk/mobile typecheck",
    "lint": "pnpm --filter @signtalk/contracts lint && pnpm --filter @signtalk/api lint",
    "typecheck": "pnpm --filter @signtalk/contracts typecheck && pnpm --filter @signtalk/api typecheck",
    "test": "pnpm --filter @signtalk/api test",
    "format": "prettier --write .",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/prisma/seed.ts",
    "compose:up": "docker compose -f infrastructure/compose.dev.yml up -d",
    "compose:down": "docker compose -f infrastructure/compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.0.0",
    "better-auth": "1.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.0.0"
  }
}
